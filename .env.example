# Server secrets. Both are read through $env/dynamic/private and never reach
# the browser. There are no PUBLIC_ variables in this project by design, and
# scripts/gates.sh fails the build if a secret-shaped one ever appears.
#
# For local development: `vercel link`, then `vercel env pull .env.local`.
# That writes the real values into .env.local, which is gitignored. Do not
# copy this file to .env and fill it in by hand — pulling keeps it current.

# Injected automatically when a Blob store is connected to the project in the
# Vercel dashboard (Storage → Create → Blob → Connect Project). You do not set
# this one yourself; if you are editing it by hand, the store is not connected.
BLOB_READ_WRITE_TOKEN=

# You create this one. Generate with `openssl rand -hex 32` and add it under
# Project Settings → Environment Variables, named exactly CRON_SECRET.
#
# The name matters: Vercel looks for a variable with that exact name and sends
# `Authorization: Bearer <value>` on every cron invocation. /api/cron/sweep
# compares it in constant time and returns 401 without it, so until this is
# set the daily sweep runs and deletes nothing.
CRON_SECRET=

# Not set by you: Vercel provides VERCEL_ENV (production | preview |
# development) automatically. src/lib/server/env.ts turns it into a blob path
# prefix, so a preview deploy sharing one store with production writes under
# preview/ and can never touch a real list. Production is deliberately
# unprefixed — giving it one would change every existing path.
